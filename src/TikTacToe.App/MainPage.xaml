<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TikTacToe.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="18">
        <VerticalStackLayout Spacing="6">
            <Label Text="Tic Tac Toe" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
            <Label x:Name="StatusLabel" FontSize="18" TextColor="{StaticResource Ink}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button
                x:Name="LocalModeButton"
                Text="2 personas"
                Clicked="OnLocalModeClicked"
                CornerRadius="8" />
            <Button
                x:Name="AiModeButton"
                Grid.Column="1"
                Text="Contra IA"
                Clicked="OnAiModeClicked"
                CornerRadius="8" />
        </Grid>

        <Grid
            x:Name="BoardGrid"
            Grid.Row="2"
            RowDefinitions="*,*,*"
            ColumnDefinitions="*,*,*"
            RowSpacing="10"
            ColumnSpacing="10" />

        <Button
            Grid.Row="3"
            Text="Reiniciar"
            Clicked="OnResetClicked"
            CornerRadius="8"
            BackgroundColor="{StaticResource Accent}"
            TextColor="White" />
    </Grid>
</ContentPage>
